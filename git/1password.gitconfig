# vim: ft=gitconfig
[gpg]
	format = ssh

[gpg "ssh"]
	# 1Password, or the agent key in ssh TTY mode (bin/git-ssh-sign).
	program = ~/.dotfiles/bin/git-ssh-sign

[commit]
	gpgsign = true

[user]
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIfhB0Vqv8zq4YAp7kjqKChycZN5k5+LH58o3rVzL2aP
	email = bezalelhermoso@gmail.com
