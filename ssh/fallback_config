# vim: set ft=sshconfig

# UseKeychain is Apple-only; don't choke on it elsewhere.
IgnoreUnknown UseKeychain

# Claude Code sessions push with this machine's agent key (bin/agent-key-setup)
# so pushes don't wait on 1Password's Touch ID prompt. Without the key, falls
# through to 1Password.
Match host github.com exec "[[ -n $CLAUDECODE && -f ~/.ssh/agent_ed25519 ]]"
    IdentityAgent SSH_AUTH_SOCK
    IdentitiesOnly yes
    IdentityFile ~/.ssh/agent_ed25519
    AddKeysToAgent yes
    UseKeychain yes

# TTY mode: when 1Password's Touch ID prompt can't be seen (SSHed in, Rex on
# the iPhone, `sshtty on`), use macOS's ssh-agent with the fallback key (a passphrase, if
# it has one, is typed at the terminal). bin/ssh-tty-mode decides; `sshtty` toggles/unlocks.
# UseKeychain stays off so a passphrase is never silently supplied by Keychain.
Match exec "~/.dotfiles/bin/ssh-tty-mode"
    IdentityAgent SSH_AUTH_SOCK
    IdentitiesOnly yes
    IdentityFile ~/.ssh/id_rsa_fallback
    AddKeysToAgent 4h
    UseKeychain no
